rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function enabled() { return signed() && profile().active == true && profile().role in ['owner', 'worker']; }
    function owner() { return enabled() && profile().role == 'owner'; }
    match /users/{userId} {
      allow read: if signed() && (request.auth.uid == userId || owner());
      allow create, update, delete: if owner();
    }
    match /products/{id} {
      allow read: if enabled();
      allow create, update, delete: if owner();
    }
    match /sales/{id} {
      allow read: if enabled();
      allow create: if enabled()
        && request.resource.data.keys().hasOnly(['items','total','received','paymentMethod','createdBy','createdAt','status'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'completed'
        && request.resource.data.total is int && request.resource.data.total >= 0
        && request.resource.data.received == request.resource.data.total
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 100;
      allow update, delete: if false;
    }
    match /orders/{id} {
      allow read: if enabled();
      allow create: if enabled()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.price is int && request.resource.data.price >= 0
        && request.resource.data.advance is int && request.resource.data.advance >= 0
        && request.resource.data.advance <= request.resource.data.price;
      allow update: if owner();
      allow delete: if false;
    }
    match /transporters/{id} {
      allow read, create: if enabled();
      allow update, delete: if owner();
    }
  }
}
